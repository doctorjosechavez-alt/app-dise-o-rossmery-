{
  "expo": {
    "name": "Estudio de Obra",
    "slug": "interior-designer-app",
    "scheme": "estudiodeobra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F1",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Se usa la cámara para grabar fotos y videos de la obra.",
        "NSPhotoLibraryAddUsageDescription": "Las fotos y videos de las notas de campo se guardan en tu galería.",
        "NSCalendarsUsageDescription": "Se usa el calendario para agregar recordatorios de tus pendientes."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-calendar",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "Se usa el micrófono para grabar notas de voz."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Las fotos y videos de las notas de campo se guardan en tu galería.",
          "savePhotosPermission": "Las fotos y videos de las notas de campo se guardan en tu galería.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-notifications",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "06da9cf6-e32b-491a-ba1a-1c9e9912f527"
      }
    },
    "owner": "drchavez",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/06da9cf6-e32b-491a-ba1a-1c9e9912f527"
    }
  }
}
